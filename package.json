{
  "name": "smart-locator-capture-studio",
  "private": true,
  "version": "0.1.0",
  "description": "Smart Locator Capture Studio — capture web elements and generate ranked, validated XPath/CSS locators.",
  "author": "Smart Locator Capture Studio",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "electron": "npm run build && electron .",
    "electron:dev": "cross-env ELECTRON_DEV=1 concurrently -k \"vite\" \"electron .\"",
    "electron:build": "npm run build && electron-builder",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test -c playwright.config.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "lucide-react": "^0.546.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.14",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "electron": "^33.0.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^25.0.1",
    "typescript": "~5.8.2",
    "vitest": "^2.1.4"
  },
  "build": {
    "appId": "com.smartlocatorcapturestudio.desktop",
    "productName": "Smart Locator Capture Studio",
    "asar": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
